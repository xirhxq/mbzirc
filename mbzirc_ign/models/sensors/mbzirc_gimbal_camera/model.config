<?xml version="1.0"?>
<model>
  <name>MBZIRC Gimbal Camera</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>MBZIRC Team</name>
    <email>info@osrfoundation.org</email>
  </author>
  <description>
    A 2-axis gimbal-stabilized HD camera with controllable pitch, yaw, and zoom (HFOV).
    Pitch: 0 to -90 degrees, Yaw: +/-180 degrees, Zoom: 2.36 to 63.7 degrees HFOV (30x).
  </description>
</model>
