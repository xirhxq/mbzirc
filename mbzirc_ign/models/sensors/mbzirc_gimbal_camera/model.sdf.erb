<%
if !defined?(topic_prefix) || topic_prefix == nil || topic_prefix.empty?
  $topic_prefix = ''
else
  $topic_prefix = topic_prefix
end
%>

<?xml version="1.0"?>
<sdf version='1.9'>
  <model name="mbzirc_gimbal_camera">

    <!-- Base link (attaches to vehicle slot) -->
    <link name='base_link'>
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>4.17e-06</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>4.17e-06</iyy>
          <iyz>0</iyz>
          <izz>8.33e-06</izz>
        </inertia>
      </inertial>
      <collision name='base_link_collision'>
        <pose>0 0 0.005 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.02</radius>
            <length>0.01</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name='base_link_visual'>
        <pose>0 0 0.005 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.02</radius>
            <length>0.01</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.3 0.3 0.3 1</ambient>
          <diffuse>0.3 0.3 0.3 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
    </link>

    <!-- Yaw joint (horizontal rotation, rotates around Z axis) -->
    <joint name='yaw_joint' type='revolute'>
      <parent>base_link</parent>
      <child>yaw_link</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-3.14159</lower>
          <upper>3.14159</upper>
          <effort>5</effort>
          <velocity>2.0</velocity>
        </limit>
        <dynamics>
          <damping>0.5</damping>
          <friction>0.1</friction>
        </dynamics>
      </axis>
    </joint>

    <!-- Yaw link -->
    <link name='yaw_link'>
      <pose>0 0 0.01 0 0 0</pose>
      <inertial>
        <mass>0.03</mass>
        <inertia>
          <ixx>2.5e-06</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>2.5e-06</iyy>
          <iyz>0</iyz>
          <izz>1.25e-06</izz>
        </inertia>
      </inertial>
      <collision name='yaw_link_collision'>
        <pose>0 0 0.005 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.015</radius>
            <length>0.01</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name='yaw_link_visual'>
        <pose>0 0 0.005 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.015</radius>
            <length>0.01</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.4 0.4 0.4 1</ambient>
          <diffuse>0.4 0.4 0.4 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
    </link>

    <!-- Pitch joint (vertical rotation, rotates around Y axis) -->
    <!-- Negative Y axis: Positive command = tilt DOWN -->
    <joint name='pitch_joint' type='revolute'>
      <parent>yaw_link</parent>
      <child>sensor_link</child>
      <axis>
        <xyz>0 -1 0</xyz>
        <limit>
          <lower>-1.5708</lower>
          <upper>1.5708</upper>
          <effort>5</effort>
          <velocity>2.0</velocity>
        </limit>
        <dynamics>
          <damping>0.5</damping>
          <friction>0.1</friction>
        </dynamics>
      </axis>
    </joint>

    <!-- Sensor link with HD camera sensor -->
    <link name='sensor_link'>
      <!-- Move camera forward to avoid obstruction from gimbal structure -->
      <pose>0.05 0 0.02 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>8.33e-06</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>8.33e-06</iyy>
          <iyz>0</iyz>
          <izz>8.33e-06</izz>
        </inertia>
      </inertial>
      <collision name='sensor_link_collision'>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.04 0.04 0.03</size>
          </box>
        </geometry>
      </collision>
      <visual name='sensor_link_visual'>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.04 0.04 0.03</size>
          </box>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.2 1</ambient>
          <diffuse>0.2 0.2 0.2 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>

      <!-- HD Camera Sensor -->
      <sensor name="camera" type="camera">
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <camera name="camera">
          <!-- Horizontal FOV: 60 degrees (1.0472 radians) -->
          <horizontal_fov>1.0472</horizontal_fov>
          <lens>
            <intrinsics>
              <fx>1663</fx>
              <fy>1663</fy>
              <cx>960.5</cx>
              <cy>540.5</cy>
              <s>0</s>
            </intrinsics>
          </lens>
          <image>
            <width>1920</width>
            <height>1080</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.01</near>
            <far>300</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0</mean>
            <stddev>0.007</stddev>
          </noise>
        </camera>
      </sensor>
    </link>

    <!-- Mount point for attaching to vehicle slots -->
    <frame name="mount_point"/>

    <!-- Joint Position Controller for Yaw (position control with angle command) -->
    <plugin
      filename="ignition-gazebo-joint-position-controller-system"
      name="ignition::gazebo::systems::JointPositionController">
      <joint_name>yaw_joint</joint_name>
      <topic>/<%= $topic_prefix %>/gimbal/yaw/cmd</topic>
      <use_velocity_commands>true</use_velocity_commands>
      <p_gain>10.0</p_gain>
      <i_gain>0</i_gain>
      <d_gain>2.0</d_gain>
    </plugin>

    <!-- Joint Position Controller for Pitch (position control with angle command) -->
    <plugin
      filename="ignition-gazebo-joint-position-controller-system"
      name="ignition::gazebo::systems::JointPositionController">
      <joint_name>pitch_joint</joint_name>
      <topic>/<%= $topic_prefix %>/gimbal/pitch/cmd</topic>
      <use_velocity_commands>true</use_velocity_commands>
      <p_gain>10.0</p_gain>
      <i_gain>0</i_gain>
      <d_gain>2.0</d_gain>
    </plugin>

    <!-- Joint State Publisher (publishes position and velocity) -->
    <plugin filename="libignition-gazebo-joint-state-publisher-system.so"
            name="ignition::gazebo::systems::JointStatePublisher">
      <joint_name>pitch_joint</joint_name>
      <joint_name>yaw_joint</joint_name>
      <topic>/<%= $topic_prefix %>/gimbal/joint_states</topic>
    </plugin>

    <!-- HFOV Zoom Control with Dynamics -->
    <plugin filename="libGimbalCameraPlugin.so"
            name="mbzirc::GimbalCameraPlugin">
      <camera_link>sensor_link</camera_link>
      <sensor_name>camera</sensor_name>
      <focal_length_min>4.5</focal_length_min>
      <focal_length_max>135.0</focal_length_max>
      <transition_time>15.0</transition_time>
      <sensor_width>6.17</sensor_width>
      <hfov_topic>/<%= $topic_prefix %>/gimbal/set_hfov</hfov_topic>
    </plugin>

  </model>
</sdf>
